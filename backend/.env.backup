# Gather API Environment Configuration
# Replace these placeholder values with your actual API keys

# Supabase Configuration (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# External API Keys (Optional - add as needed)
GOOGLE_API_KEY=your-google-api-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_SECRET_KEY=your-stripe-secret-key
NOTION_CLIENT_ID=your-notion-client-id
NOTION_CLIENT_SECRET=your-notion-client-secret
FIRECRAWL_API_KEY=your-firecrawl-api-key
TAVILY_API_KEY=your-tavily-api-key

# Development Settings
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Context Testing (Optional)
CONTEXT_TESTING_ENABLED=false
CONTEXT_TESTING_WEBHOOK_URL=https://webhook-test.com/e29a3cadb83bac54209b07b994a4f288
